# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=earnflow-frontend

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=https://yoursite.com

# Resend
RESEND_API_KEY=re_...

# Launch config (optional — defaults live in lib/launch.config.ts)
# Reset the countdown by changing this date and redeploying.
NEXT_PUBLIC_COUNTDOWN_END=2026-06-03T23:59:59Z
# Update spots remaining by changing this number and redeploying.
NEXT_PUBLIC_SPOTS_REMAINING=8
